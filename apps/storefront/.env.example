# ---------------------------------------------------------------------------
# Ajooba Footwear — storefront environment template
#
# Copy to `.env.local`:
#   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# bundle. Everything else stays on the server. Never put a secret in a
# NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# Runtime. Set by the platform. Allowed: development | test | production
NODE_ENV=development

# Base URL of the REST API, used for server-side fetches (never exposed).
API_INTERNAL_URL=http://localhost:4000

# Base URL of the REST API, used by browser-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public origin of this storefront. Used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL for catalogue images. The catalogue stores image paths as
# root-relative (/products/AJ-A1/...), and the API serves that tree at its
# own origin. In production this becomes the CDN/object-store origin.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000

# ISR revalidation window for catalogue pages, in seconds. 0 disables caching.
CATALOG_REVALIDATE_SECONDS=300
