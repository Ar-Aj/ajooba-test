# ---------------------------------------------------------------------------
# Ajooba Footwear — admin panel environment template
#
# Copy to `.env.local`:
#   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# bundle. Everything else stays on the server. Never put a secret in a
# NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# Runtime. Set by the platform. Allowed: development | test | production
NODE_ENV=development

# Base URL of the REST API, used for server-side fetches (never exposed).
API_INTERNAL_URL=http://localhost:4000

# Base URL of the REST API, used by browser-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public origin of this admin panel.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public base path for catalogue images served from /public.
NEXT_PUBLIC_MEDIA_BASE_URL=/
