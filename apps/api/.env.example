# ---------------------------------------------------------------------------
# Ajooba Footwear — API environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# Every deployment target (development / staging / production) supplies its
# OWN values. There is no `mode=dev` / `mode=pro` switch — the application
# reads exactly what the platform provides and fails to boot if a required
# variable is missing.
#
# NEVER commit a filled-in .env. See .gitignore.
# ---------------------------------------------------------------------------

# Runtime. Set by the platform. Allowed: development | test | production
NODE_ENV=development

# HTTP port for the API process.
PORT=4000

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Keep credentials out of version control.
# The database name is derived from this URI unless MONGODB_DB is set.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional explicit database name (recommended per environment).
MONGODB_DB=ajooba_development

# --- Public URLs ----------------------------------------------------------
# Absolute URL where the API is reachable from the public internet.
API_PUBLIC_URL=http://localhost:4000
MEDIA_STATIC_DIR=./public
# Public origin of the customer storefront.
STOREFRONT_PUBLIC_URL=http://localhost:3000
# Public origin of the admin panel.
ADMIN_PUBLIC_URL=http://localhost:3001

# --- CORS ----------------------------------------------------------------
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma separated list of allowed admin origins (subset of CORS_ORIGINS).
ADMIN_ORIGINS=http://localhost:3001

# --- Security ------------------------------------------------------------
# Secret used to sign admin session tokens. Must be at least 32 characters.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-64-character-random-string-generated-locally

# Secret used to sign access/refresh tokens. Must be at least 32 characters
# and MUST be different from SESSION_SECRET. Rotating it invalidates every
# issued token.
JWT_SECRET=replace-me-with-a-different-64-character-random-string-generated-locally

# Token issuer claim. Purely informational.
JWT_ISSUER=ajooba-api

# Access token lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds (default 2592000 = 30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000

# bcrypt cost factor. 10-15. Higher is slower and stronger (default 12).
BCRYPT_COST=12

# Failed-login budget per account before a temporary lock (default 10).
# Set to 0 to disable account lockout.
MAX_FAILED_LOGIN_ATTEMPTS=10

# How long an account stays locked, in seconds (default 900 = 15 minutes).
ACCOUNT_LOCKOUT_SECONDS=900

# --- Social sign-in (Google, Facebook) ------------------------------------
# Both are optional. A provider whose two values are blank is simply not
# offered: the API answers 503 for its start route and the storefront does
# not render the button. Fill in a pair to open that door.
#
# The authorized redirect URI to register in each provider's console is
#   <API_PUBLIC_URL>/v1/auth/oauth/google/callback
#   <API_PUBLIC_URL>/v1/auth/oauth/facebook/callback
# The API derives it from API_PUBLIC_URL rather than asking for it twice.
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin:  <STOREFRONT_PUBLIC_URL>
#   Authorized redirect URI:      <API_PUBLIC_URL>/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Facebook: https://developers.facebook.com/apps -> Facebook Login -> Settings
#   Valid OAuth Redirect URI:     <API_PUBLIC_URL>/v1/auth/oauth/facebook/callback
# The app must request the `email` permission, or Facebook returns no address
# and the sign-in is refused (an account with no reachable address cannot be
# sent an order confirmation).
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# --- Cloudinary (product media) ------------------------------------------
# The API secret below is SERVER-SIDE ONLY. It is never sent to a browser
# and never appears in a response body or a log line.
#
# Leave all three blank to run without Cloudinary: the importer then keeps
# the local `public/` image paths and the API serves the media from disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder inside the Cloudinary account for product imagery.
CLOUDINARY_PRODUCT_FOLDER=ajooba/products

# Optional override for the delivery base URL (custom CDN domain).
CLOUDINARY_DELIVERY_BASE_URL=

# Cloudinary transformation applied to every uploaded product image.
CLOUDINARY_TRANSFORMATION=w_1600,c_limit,q_auto,f_auto

# --- Catalogue import -----------------------------------------------------
# Root of the source catalogue assets. The importer reads it read-only.
CATALOG_SOURCE_DIR=../../public

# Where the importer writes its per-run reports.
CATALOG_REPORT_DIR=../../artifacts/import-reports

# Refuse to import into a database whose name looks like production.
IMPORT_BLOCK_PRODUCTION=true
#
# Importer only. Allow the import to write stock values derived from the
# listing templates. OFF by default: the templates are a marketplace export,
# not a warehouse ledger. Leave it false unless the operator has counted
# stock and deliberately wants it written from the templates.
IMPORT_APPLY_TEMPLATE_STOCK=false

# --- Payments (Razorpay) --------------------------------------------------
# Razorpay credentials. The API refuses to boot in `live` mode unless the key
# pair AND the webhook secret are all present, so a half-configured live
# integration cannot reach production.
#
# Leave the pair blank to run without payments: the payment intent route
# answers 503 and the checkout route refuses an online payment method.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The webhook secret from the Razorpay dashboard. It is SEPARATE from the
# key secret and signs the `x-razorpay-signature` header. Blank means the
# webhook endpoint rejects every delivery.
RAZORPAY_WEBHOOK_SECRET=

# Which key pair is loaded: `test` | `live`. Never inferred.
RAZORPAY_MODE=test

# --- Transactional email (Resend) -----------------------------------------
# Both must be set together, or the API refuses to boot. The domain in
# RESEND_FROM_EMAIL must already be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional reply-to address. Defaults to RESEND_FROM_EMAIL.
RESEND_REPLY_TO=
#
# Development-only allowlist for outbound email (comma separated). Outside
# production, a recipient that is not on this list is recorded as `skipped`
# instead of delivered. In production the allowlist is not consulted.
EMAIL_ALLOWLIST=

# --- Shipping (Shiprocket) ------------------------------------------------
# The API-user credential pair that mints the Shiprocket bearer token.
# Both must be set together, or the API refuses to boot.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
#
# The pickup location name configured in the Shiprocket account. It must
# already exist there; Shiprocket rejects an unknown location.
SHIPROCKET_PICKUP_LOCATION=
#
# Optional pinned courier id. Blank lets Shiprocket choose from the
# serviceable courier list.
SHIPROCKET_COURIER_ID=
#
# The shared secret checked against the Shiprocket tracking webhook's
# `x-api-key` header. Blank disables webhook acceptance outright.
SHIPROCKET_WEBHOOK_SECRET=

# --- Rate limiting --------------------------------------------------------
# Requests per window, per IP. The defaults are deliberately tight; a
# deployment behind a shared NAT may raise them.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_COUPON_MAX=30
RATE_LIMIT_PASSWORD_MAX=10
RATE_LIMIT_ANALYTICS_MAX=120
RATE_LIMIT_ADMIN_WRITE_MAX=120

# --- Observability --------------------------------------------------------
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
