# ---------------------------------------------------------------------------
# Ajooba Footwear — API test environment
#
# Used by `pnpm --filter @ajooba/api test`.
# These values are deliberately non-secret and are safe to commit.
#
# MONGODB_URI points at a loopback address that will not resolve, so the
# readiness probe correctly reports `error` in tests instead of hanging or
# passing misleadingly. The liveness probe does not touch MongoDB at all.
# ---------------------------------------------------------------------------

NODE_ENV=test
PORT=4100

MONGODB_URI=mongodb://127.0.0.1:1/ajooba_test
MONGODB_DB=ajooba_test

API_PUBLIC_URL=http://localhost:4100
STOREFRONT_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_ORIGINS=http://localhost:3001

SESSION_SECRET=test-only-session-secret-value-at-least-32-characters-long
JWT_SECRET=test-only-jwt-secret-value-at-least-32-characters-long

# bcrypt cost is lowered in tests so the suite stays fast. The hashing
# algorithm and the verification path are identical to production.
BCRYPT_COST=4

# Rate-limit budgets are raised in tests so the suite is not throttled by a
# limit that exists to protect production. Every request in a test run comes
# from the same loopback address, so the production budgets would otherwise
# fail the suite long before it finished.
RATE_LIMIT_AUTH_MAX=1000000
RATE_LIMIT_REFRESH_MAX=1000000
RATE_LIMIT_REGISTER_MAX=1000000
RATE_LIMIT_CHECKOUT_MAX=1000000
RATE_LIMIT_COUPON_MAX=1000000
RATE_LIMIT_PASSWORD_MAX=1000000
RATE_LIMIT_ANALYTICS_MAX=1000000
RATE_LIMIT_ADMIN_WRITE_MAX=1000000

LOG_LEVEL=fatal