{
  "name": "ajooba-footwear",
  "version": "0.1.0",
  "private": true,
  "description": "Ajooba Footwear — mobile-first Indian footwear e-commerce platform",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter \"./apps/*\" --filter \"@ajooba/contracts\" dev",
    "dev:contracts": "pnpm --filter @ajooba/contracts dev",
    "dev:storefront": "pnpm --filter @ajooba/storefront dev",
    "dev:admin": "pnpm --filter @ajooba/admin dev",
    "dev:api": "pnpm --filter @ajooba/api dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:contracts": "pnpm --filter @ajooba/contracts build",
    "start": "pnpm -r --filter \"./apps/*\" start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm --filter @ajooba/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @ajooba/contracts build && pnpm -r test",
    "test:coverage": "pnpm --filter @ajooba/contracts build && pnpm -r test:coverage",
    "test:api": "pnpm --filter @ajooba/api test",
    "test:contracts": "pnpm --filter @ajooba/contracts test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:full": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "clean": "pnpm -r exec rm -rf node_modules .next dist .turbo coverage",
    "catalog:audit": "python scripts/catalog_audit.py",
    "catalog:conflicts": "python scripts/conflict_classify.py",
    "mcp:setup": "node scripts/mcp/setup-local-mcp-user.cjs",
    "mcp:verify": "node scripts/mcp/verify-mcp-connection.mjs",
    "mcp:inspect": "node scripts/mcp/inspect-dev-db.mjs",
    "readiness": "node scripts/readiness-check.mjs",
    "env:check": "node scripts/env-inventory-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mongoose": "^9.11.2",
    "mongodb-memory-server": "^11.3.0",
    "mongodb-mcp-server": "1.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
