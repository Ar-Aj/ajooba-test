# ---------------------------------------------------------------------------
# Ajooba Footwear — MongoDB MCP environment template
#
# Copy to `.env.mcp` and fill in real values. `.env.mcp` is git-IGNORED and
# must never be committed — it carries a database password.
#
#     node scripts/mcp/setup-local-mcp-user.cjs   (generates .env.mcp for you)
#
# The server reads these names directly (prefix `MDB_MCP_`), so no CLI flags
# are needed. See docs/ARCHITECTURE.md §7.2.
# ---------------------------------------------------------------------------

# Connection string for the MCP server.
#
# Development  : mongodb://<user>:<password>@127.0.0.1:27017/ajooba_development?authSource=ajooba_development
# Atlas (dev)  : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&authSource=admin
#
# NEVER point this at a production cluster or database.
MDB_MCP_CONNECTION_STRING=mongodb://ajooba_mcp:CHANGE_ME@127.0.0.1:27017/ajooba_development?authSource=ajooba_development

# Read-only mode. Allows read/connect/metadata operations only; every
# create/update/delete operation type is refused by the server itself.
MDB_MCP_READ_ONLY=true

# No telemetry from the MCP server.
MDB_MCP_TELEMETRY=disabled

# Belt-and-braces: destructive tools are not even advertised.
# `readOnly=true` already refuses these; listing them makes the intent obvious
# in review and survives a flag being dropped by mistake.
MDB_MCP_DISABLED_TOOLS=drop-database,drop-collection,rename-collection,delete-one,delete-many,insert-one,insert-many,update-one,update-many,create-index,drop-index,drop-indexes