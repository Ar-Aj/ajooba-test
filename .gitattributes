# ---------------------------------------------------------------------------
# Git LFS configuration for Ajooba Footwear source assets.
#
# The original product photography and catalogue workbooks are authoritative
# business assets. They are tracked with Git LFS so the repository stays
# responsive while every original byte is preserved and versioned.
#
# Developers need Git LFS installed:  https://git-lfs.com
# ---------------------------------------------------------------------------

# Product photography
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.avif filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Catalogue workbooks / spreadsheets
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text

# Binary documents
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
